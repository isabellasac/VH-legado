# Obtenha a string de conexão em Neon > Connection Details.
# Mantenha sslmode=require para conexões seguras ao Neon.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-DO-NEON/NOME_DO_BANCO?sslmode=require

# Só é necessária se o frontend for hospedado separadamente da API.
CAREOPS_CORS_ALLOWED_ORIGINS=http://localhost:4310
